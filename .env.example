# Copy this file to .env and add your own NVIDIA API key.
# auto prefers NVIDIA when its key is present, then OpenAI, then local reference chat.
# Never commit a real API key.
AI_PROVIDER=auto
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional fallback provider. Keep AI_PROVIDER=auto to use it when NVIDIA is not configured.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-6.2-astra
